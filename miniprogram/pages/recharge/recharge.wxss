.title { font-weight: 600; margin-bottom: 24rpx; }
.amount-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 24rpx; }
.amount-item {
  width: calc(33% - 12rpx);
  text-align: center;
  padding: 24rpx 0;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
}
.amount-item.active { border-color: #d4202a; background: #fffbe6; color: #d4202a; font-weight: 600; }

.custom-box {
  display: flex;
  align-items: center;
  border: 2rpx solid #e8ecf4;
  border-radius: 12rpx;
  padding: 8rpx 20rpx;
  margin-bottom: 16rpx;
  background: #f8f9fc;
}
.custom-prefix {
  font-size: 36rpx;
  font-weight: 600;
  color: #111111;
  margin-right: 8rpx;
}
.custom-input {
  flex: 1;
  height: 72rpx;
  font-size: 32rpx;
}
.hint {
  color: #9ca3af;
  font-size: 24rpx;
  margin-bottom: 32rpx;
}

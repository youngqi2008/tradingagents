<view class="container container--no-tab">
  <view class="card">
    <view class="title">选择充值金额</view>
    <view class="amount-grid">
      <view
        wx:for="{{amounts}}"
        wx:key="*this"
        class="amount-item {{!custom && selected === item ? 'active' : ''}}"
        bindtap="selectAmount"
        data-amount="{{item}}"
      >¥{{item}}</view>
      <view class="amount-item {{custom ? 'active' : ''}}" bindtap="selectCustom">自定义</view>
    </view>
    <view class="custom-box" wx:if="{{custom}}">
      <text class="custom-prefix">¥</text>
      <input
        class="custom-input"
        type="digit"
        placeholder="请输入 {{minAmount}}～{{maxAmount}} 整数元"
        value="{{customAmount}}"
        bindinput="onCustomInput"
        focus="{{custom}}"
      />
    </view>
    <view class="hint">金额须为整数元（iOS 最低 1 元）。安卓走微信支付，iOS 走 Apple 支付。</view>
    <button class="btn-primary" bindtap="pay" loading="{{paying}}">确认支付 ¥{{payAmount}}</button>
  </view>
</view>

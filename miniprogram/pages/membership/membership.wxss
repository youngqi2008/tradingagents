.current-card {
  text-align: center;
  background: linear-gradient(135deg, #111111, #2d2d44);
  color: #fff;
}
.current-label {
  font-size: 24rpx;
  opacity: 0.75;
}
.current-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #ef4444;
  margin-top: 8rpx;
}
.current-balance {
  font-size: 32rpx;
  margin-top: 16rpx;
}
.quota-row {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
  opacity: 0.9;
}
.fee-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: 0.85;
}
.fee-hint .paid { color: #fca5a5; }
.fee-hint .unpaid { color: #fef08a; }

.section-title {
  margin: 8rpx 24rpx 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #666;
}
.loading-tip {
  text-align: center;
  color: #999;
  padding: 48rpx;
}

.level-card {
  margin-top: 16rpx;
}
.level-current {
  border: 2rpx solid #d4202a;
}
.level-selected {
  box-shadow: 0 0 0 4rpx rgba(212, 32, 42, 0.28);
}
.level-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.level-name {
  font-size: 34rpx;
  font-weight: 600;
}
.badge-current,
.badge-upgrade,
.badge-downgrade {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.badge-current { background: #d4202a; color: #ffffff; }
.badge-upgrade { background: #fff1f2; color: #be123c; }
.badge-downgrade { background: #f4f4f5; color: #71717a; }

.level-fee {
  font-size: 36rpx;
  font-weight: 700;
  color: #d4202a;
  margin: 16rpx 0 8rpx;
}
.level-fee.free {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}
.level-benefits {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 26rpx;
  color: #666;
}
.level-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
}
.level-btn {
  margin-top: 20rpx;
  border-radius: 12rpx;
  font-weight: 600;
  width: 100%;
}
.btn-disabled {
  background: #f0f0f0 !important;
  color: #999 !important;
}
.btn-outline {
  background: #fff;
  color: #111111;
  border: 1px solid #d4202a;
}

.tip-card {
  margin-top: 8rpx;
  margin-bottom: 48rpx;
}
.tip-title {
  font-weight: 600;
  margin-bottom: 12rpx;
}
.tip-line {
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 1.8;
}
.guest-card {
  text-align: center;
  background: linear-gradient(135deg, #111111, #2d2d44);
  color: #fff;
}
.guest-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: 0.85;
  line-height: 1.5;
}
.guest-login {
  margin-top: 28rpx;
}
.recharge-btn {
  margin-top: 20rpx;
}

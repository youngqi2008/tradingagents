.current-card {
  text-align: center;
  background: linear-gradient(135deg, #1a1a2e, #2d2d44);
  color: #fff;
}
.current-label {
  font-size: 24rpx;
  opacity: 0.75;
}
.current-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #e8c547;
  margin-top: 8rpx;
}
.current-balance {
  font-size: 32rpx;
  margin-top: 16rpx;
}
.quota-row {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
  opacity: 0.9;
}
.fee-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: 0.85;
}
.fee-hint .paid { color: #7dcea0; }
.fee-hint .unpaid { color: #f5b7b1; }

.section-title {
  margin: 8rpx 24rpx 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #666;
}
.loading-tip {
  text-align: center;
  color: #999;
  padding: 48rpx;
}

.level-card {
  margin-top: 16rpx;
}
.level-current {
  border: 2rpx solid #c9a227;
}
.level-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.level-name {
  font-size: 34rpx;
  font-weight: 600;
}
.badge-current,
.badge-upgrade,
.badge-downgrade {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.badge-current { background: #c9a227; color: #1a1a2e; }
.badge-upgrade { background: #e8f5e9; color: #2e7d32; }
.badge-downgrade { background: #f5f5f5; color: #666; }

.level-fee {
  font-size: 36rpx;
  font-weight: 700;
  color: #c9a227;
  margin: 16rpx 0 8rpx;
}
.level-fee.free {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}
.level-benefits {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 26rpx;
  color: #666;
}
.level-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
}
.level-btn {
  margin-top: 20rpx;
  border-radius: 12rpx;
  font-weight: 600;
}
.btn-disabled {
  background: #f0f0f0 !important;
  color: #999 !important;
}
.btn-outline {
  background: #fff;
  color: #1a1a2e;
  border: 1px solid #c9a227;
}

.tip-card {
  margin-top: 8rpx;
  margin-bottom: 48rpx;
}
.tip-title {
  font-weight: 600;
  margin-bottom: 12rpx;
}
.tip-line {
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 1.8;
}
.recharge-btn {
  margin-top: 20rpx;
}

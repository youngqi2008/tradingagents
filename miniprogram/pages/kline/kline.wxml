<view class="page container">
  <view class="pane-bar">
    <view class="pane-item {{pane === 'kline' ? 'active' : ''}}" data-pane="kline" bindtap="switchPane">行情</view>
    <view class="pane-item {{pane === 'news' ? 'active' : ''}}" data-pane="news" bindtap="switchPane">新闻</view>
  </view>

  <block wx:if="{{pane === 'kline'}}">
    <!-- 搜索 -->
    <view class="search-card">
      <view class="search-row">
        <view class="input-with-clear">
          <input
            class="search-input input-clearable"
            placeholder="默认沪指，输入个股代码如 600519"
            value="{{keyword}}"
            bindinput="onKeywordInput"
            bindconfirm="onSearchConfirm"
            confirm-type="search"
          />
          <view class="input-clear" wx:if="{{keyword}}" catchtap="onClearKeyword">×</view>
        </view>
        <button class="btn-search" bindtap="onSearchConfirm">查询</button>
        <button
          class="btn-fav {{isFavorite ? 'on' : ''}}"
          wx:if="{{canSubscribe}}"
          bindtap="onToggleFavorite"
          loading="{{favLoading}}"
          disabled="{{favLoading}}"
        >{{isFavorite ? '已订阅' : '订阅'}}</button>
      </view>
      <view class="suggest-list" wx:if="{{suggests.length}}">
        <view
          class="suggest-item"
          wx:for="{{suggests}}"
          wx:key="code"
          data-code="{{item.code}}"
          data-name="{{item.name}}"
          bindtap="onSelectSuggest"
        >
          <text class="suggest-code">{{item.code}}</text>
          <text class="suggest-name">{{item.name}}</text>
          <text
            class="suggest-fav"
            wx:if="{{!item.is_index}}"
            catchtap="onSuggestFavorite"
            data-code="{{item.code}}"
            data-name="{{item.name}}"
          >+订阅</text>
        </view>
      </view>
    </view>

    <!-- 报价头 -->
    <view class="quote-card" wx:if="{{quote}}">
      <view class="quote-main">
        <view class="quote-name-row">
          <view class="quote-title-wrap">
            <text class="quote-name">{{quote.name || stockName || '-'}}</text>
            <text class="quote-code">{{stockCode}}</text>
          </view>
          <button
            class="btn-fav-quote {{isFavorite ? 'on' : ''}}"
            wx:if="{{canSubscribe}}"
            bindtap="onToggleFavorite"
            loading="{{favLoading}}"
            disabled="{{favLoading}}"
          >{{isFavorite ? '已订阅' : '+ 订阅'}}</button>
        </view>
        <view class="quote-price-row {{quoteUp ? 'up' : (quoteDown ? 'down' : '')}}">
          <text class="quote-price">{{priceText}}</text>
          <text class="quote-chg">{{chgText}}</text>
        </view>
      </view>
      <view class="quote-meta">
        <text>开 {{openText}}</text>
        <text>高 {{highText}}</text>
        <text>低 {{lowText}}</text>
        <text>额 {{amountText}}</text>
      </view>
    </view>

    <!-- 周期 -->
    <view class="period-bar">
      <view
        wx:for="{{periods}}"
        wx:key="value"
        class="period-item {{period === item.value ? 'active' : ''}}"
        data-period="{{item.value}}"
        bindtap="onPeriodChange"
      >{{item.label}}</view>
    </view>

    <!-- K 线 -->
    <view class="chart-card">
      <view class="chart-hint" wx:if="{{loading}}">加载中…</view>
      <view class="chart-hint" wx:elif="{{errorMsg}}">{{errorMsg}}</view>
      <view class="chart-hint" wx:elif="{{!hasData}}">暂无 K 线数据</view>
      <canvas
        type="2d"
        id="klineCanvas"
        class="kline-canvas"
        style="width: {{canvasWidth}}px; height: {{canvasHeight}}px;"
      ></canvas>
      <view class="chart-legend" wx:if="{{hasData}}">
        <text>{{periodLabel}} · {{barCount}} 根</text>
        <text wx:if="{{lastTime}}">最近 {{lastTime}}</text>
      </view>
    </view>
    </block>

    <block wx:elif="{{pane === 'news'}}">
      <view class="news-wrap" wx:if="{{!newsDetail}}">
        <view class="news-toolbar">
          <view class="news-chip {{newsOnlyFav ? 'on' : ''}}" bindtap="toggleNewsOnlyFav">只看自选</view>
          <view class="news-chip" bindtap="onNewsRefresh">刷新</view>
        </view>
        <view class="news-empty" wx:if="{{!newsLoading && !newsDisplayList.length}}">
          暂无最近财经新闻，请稍后刷新
        </view>
        <view class="news-list" wx:if="{{newsDisplayList.length}}">
          <view
            class="news-card {{item.highlight ? 'fav' : ''}}"
            wx:for="{{newsDisplayList}}"
            wx:key="id"
            bindtap="onOpenNews"
            data-id="{{item.id}}"
          >
            <view class="news-card-hd">
              <view class="news-badges">
                <text class="news-tag fav-tag" wx:if="{{item.highlight}}">自选</text>
                <text class="news-tag code" wx:if="{{item.symbol}}">{{item.symbol}}</text>
                <text class="news-tag name" wx:if="{{item.stock_name}}">{{item.stock_name}}</text>
              </view>
              <text class="news-time">{{item.timeText}}</text>
            </view>
            <text class="news-title">{{item.title}}</text>
            <text class="news-summary" wx:if="{{item.summary}}">{{item.summary}}</text>
            <view class="news-card-ft">
              <text>{{item.source || '财经资讯'}}</text>
              <text class="news-expand">{{item.hasMore || item.content ? '点击查看全文 ›' : '点击查看 ›'}}</text>
            </view>
          </view>
        </view>
        <view class="news-empty" wx:if="{{newsLoading}}">加载中...</view>
      </view>

      <view class="news-wrap" wx:else>
        <view class="news-detail-card">
          <view class="news-card-hd">
            <view class="news-badges">
              <text class="news-tag fav-tag" wx:if="{{newsDetail.highlight}}">自选</text>
              <text class="news-tag code" wx:if="{{newsDetail.symbol}}">{{newsDetail.symbol}}</text>
              <text class="news-tag name" wx:if="{{newsDetail.stock_name}}">{{newsDetail.stock_name}}</text>
            </view>
            <text class="news-time">{{newsDetail.timeText}}</text>
          </view>
          <view class="news-detail-title">{{newsDetail.title}}</view>
          <view class="news-detail-meta">
            <text>{{newsDetail.source || '财经资讯'}}</text>
            <text wx:if="{{newsDetail.favorite_symbolsText}}">关联 {{newsDetail.favorite_symbolsText}}</text>
          </view>
          <rich-text class="news-md" nodes="{{newsDetail.contentHtml}}"></rich-text>
          <view class="news-detail-actions">
            <button class="news-btn" wx:if="{{newsDetail.url}}" bindtap="onOpenNewsLink">打开原文</button>
            <button class="news-btn" wx:if="{{newsDetail.url}}" bindtap="onCopyNewsLink">复制链接</button>
            <button class="news-btn primary" wx:if="{{newsDetail.symbol}}" bindtap="onNewsGoKline">查看行情 {{newsDetail.symbol}}</button>
          </view>
          <button class="news-btn-back" bindtap="onCloseNewsDetail">返回列表</button>
        </view>
      </view>
    </block>
</view>

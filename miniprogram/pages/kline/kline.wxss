.page {
  min-height: 100vh;
  background: var(--color-bg);
}

.login-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
}

.login-hero {
  text-align: center;
  margin-bottom: 64rpx;
}

.login-logo {
  display: block;
  font-size: 64rpx;
  font-weight: 800;
  color: var(--color-accent);
}

.login-title {
  display: block;
  margin-top: 16rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.login-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.btn-login {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, var(--color-accent), var(--color-accent-light));
  color: var(--color-primary);
  font-weight: 600;
  border-radius: 44rpx;
  border: none;
}

.btn-login::after {
  border: none;
}

.search-card {
  margin: 24rpx;
  padding: 24rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.search-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.search-input {
  flex: 1;
  height: 76rpx;
  padding: 0 28rpx;
  background: #f5f7fb;
  border-radius: 38rpx;
  font-size: 28rpx;
}

.btn-search {
  flex-shrink: 0;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 28rpx;
  margin: 0;
  background: linear-gradient(135deg, #1a1a2e, #2d3561);
  color: #fff;
  font-size: 26rpx;
  border-radius: 38rpx;
  border: none;
}

.btn-search::after {
  border: none;
}

.btn-fav {
  flex-shrink: 0;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 22rpx;
  margin: 0;
  background: #fff4d6;
  color: #8a6d1a;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 38rpx;
  border: 1rpx solid rgba(201, 162, 39, 0.45);
}
.btn-fav::after { border: none; }
.btn-fav.on {
  background: #e8ecf4;
  color: #6b7280;
  border-color: #d1d5db;
}

.suggest-list {
  margin-top: 16rpx;
  border-top: 1rpx solid var(--color-border);
}

.suggest-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 8rpx;
  border-bottom: 1rpx solid #f0f2f8;
}

.suggest-code {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-primary);
  width: 140rpx;
  flex-shrink: 0;
}

.suggest-name {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.suggest-fav {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #8a6d1a;
  background: rgba(201, 162, 39, 0.14);
}

.quote-card {
  margin: 0 24rpx 16rpx;
  padding: 28rpx;
  background: linear-gradient(135deg, #1a1a2e 0%, #2d3561 100%);
  border-radius: var(--radius-lg);
  color: #fff;
  box-shadow: 0 12rpx 40rpx rgba(26, 26, 46, 0.18);
}

.quote-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.quote-title-wrap {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  min-width: 0;
  flex: 1;
}

.quote-name {
  font-size: 34rpx;
  font-weight: 700;
}

.quote-code {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.65);
}

.btn-fav-quote {
  flex-shrink: 0;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 22rpx;
  margin: 0;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 28rpx;
  background: rgba(232, 197, 71, 0.95);
  color: #1a1a2e;
  border: none;
}
.btn-fav-quote::after { border: none; }
.btn-fav-quote.on {
  background: rgba(255, 255, 255, 0.18);
  color: rgba(255, 255, 255, 0.9);
}

.quote-price-row {
  margin-top: 16rpx;
  display: flex;
  align-items: baseline;
  gap: 20rpx;
}

.quote-price {
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.1;
}

.quote-chg {
  font-size: 28rpx;
}

.quote-price-row.up .quote-price,
.quote-price-row.up .quote-chg {
  color: #f87171;
}

.quote-price-row.down .quote-price,
.quote-price-row.down .quote-chg {
  color: #4ade80;
}

.quote-meta {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx 28rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

.period-bar {
  display: flex;
  margin: 0 24rpx 16rpx;
  padding: 8rpx;
  background: var(--color-surface);
  border-radius: 40rpx;
  box-shadow: var(--shadow-sm);
}

.period-item {
  flex: 1;
  text-align: center;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  border-radius: 32rpx;
}

.period-item.active {
  background: linear-gradient(135deg, var(--color-accent), var(--color-accent-light));
  color: var(--color-primary);
  font-weight: 600;
}

.chart-card {
  margin: 0 24rpx;
  padding: 20rpx 12rpx 16rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  position: relative;
  min-height: 480rpx;
}

.chart-hint {
  position: absolute;
  left: 0;
  right: 0;
  top: 40%;
  text-align: center;
  color: var(--color-text-muted);
  font-size: 26rpx;
  z-index: 1;
}

.kline-canvas {
  width: 100%;
  display: block;
}

.chart-legend {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 16rpx 0;
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.pane-bar {
  display: flex;
  margin: 24rpx 24rpx 0;
  padding: 8rpx;
  background: var(--color-surface);
  border-radius: 40rpx;
  box-shadow: var(--shadow-sm);
}
.pane-item {
  flex: 1;
  text-align: center;
  height: 68rpx;
  line-height: 68rpx;
  font-size: 28rpx;
  color: var(--color-text-secondary);
  border-radius: 32rpx;
}
.pane-item.active {
  background: linear-gradient(135deg, var(--color-accent), var(--color-accent-light));
  color: var(--color-primary);
  font-weight: 600;
}

.news-wrap {
  padding: 20rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
}
.news-toolbar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.news-chip {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #6b7280;
  font-size: 24rpx;
  border: 1rpx solid #e5e7eb;
}
.news-chip.on {
  background: #1a1a2e;
  color: #c9a227;
  border-color: #1a1a2e;
}
.news-empty {
  text-align: center;
  color: #9ca3af;
  padding: 80rpx 0;
  font-size: 26rpx;
}
.news-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid transparent;
  box-shadow: 0 4rpx 16rpx rgba(26, 26, 46, 0.04);
}
.news-card.fav {
  background: linear-gradient(180deg, #fff9e8 0%, #ffffff 48%);
  border-color: #e8c547;
}
.news-card-hd {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.news-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  flex: 1;
}
.news-tag {
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  background: #f3f4f6;
  color: #6b7280;
}
.news-tag.fav-tag {
  background: #c9a227;
  color: #1a1a2e;
  font-weight: 700;
}
.news-tag.code {
  background: #eef2ff;
  color: #4338ca;
}
.news-time {
  font-size: 22rpx;
  color: #9ca3af;
  white-space: nowrap;
}
.news-title {
  display: block;
  font-size: 30rpx;
  font-weight: 650;
  color: #111827;
  line-height: 1.45;
}
.news-summary {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.55;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}
.news-card-ft {
  margin-top: 14rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  font-size: 22rpx;
  color: #9ca3af;
}
.news-expand {
  color: #c9a227;
  font-weight: 600;
  white-space: nowrap;
}
.news-detail-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 6rpx 24rpx rgba(26, 26, 46, 0.06);
}
.news-detail-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a2e;
  line-height: 1.45;
}
.news-detail-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 16rpx 0 24rpx;
  font-size: 22rpx;
  color: #9ca3af;
}
.news-detail-content {
  font-size: 28rpx;
  line-height: 1.75;
  color: #374151;
  white-space: pre-wrap;
  word-break: break-word;
  margin-bottom: 28rpx;
}
.news-detail-actions {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-bottom: 16rpx;
}
.news-btn {
  margin: 0;
  background: #fff;
  color: #1a1a2e;
  border: 1px solid #c9a227;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.news-btn::after { border: none; }
.news-btn.primary {
  background: linear-gradient(135deg, #e8c547, #c9a227);
  border-color: transparent;
}
.news-btn-back {
  margin: 0;
  background: #f3f5fa;
  color: #6b7280;
  border: none;
  border-radius: 12rpx;
  font-size: 28rpx;
}
.news-btn-back::after { border: none; }

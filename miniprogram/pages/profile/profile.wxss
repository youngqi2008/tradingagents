.page {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: calc(110rpx + env(safe-area-inset-bottom));
}

.login-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx;
}
.login-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #e8ecf4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #9ca3af;
  margin-bottom: 32rpx;
}
.login-title {
  font-size: 36rpx;
  font-weight: 700;
}
.login-desc {
  font-size: 26rpx;
  color: var(--color-text-muted);
  margin: 12rpx 0 48rpx;
}
.btn-block {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
}

.profile-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 40rpx 32rpx 32rpx;
  background: linear-gradient(180deg, #1a1a2e 0%, #2d3561 60%, var(--color-bg) 100%);
}
.avatar-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: normal;
  flex-shrink: 0;
}
.avatar-btn::after { border: none; }
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(201, 162, 39, 0.6);
  display: block;
}
.avatar-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #3d4563;
  color: var(--color-accent);
  font-size: 40rpx;
  font-weight: 600;
}
.header-info {
  flex: 1;
  min-width: 0;
}
.nickname-input {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  height: 48rpx;
  min-height: 48rpx;
  padding: 0;
}
.profile-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
}
.level-badge {
  display: inline-block;
  margin-top: 12rpx;
  padding: 6rpx 20rpx;
  background: rgba(201, 162, 39, 0.25);
  color: var(--color-accent-light);
  font-size: 22rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.asset-card {
  display: flex;
  margin: -20rpx 24rpx 24rpx;
  padding: 32rpx 16rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}
.asset-item {
  flex: 1;
  text-align: center;
}
.asset-label {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-muted);
}
.asset-value {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-top: 8rpx;
}
.asset-value.sm {
  font-size: 28rpx;
}
.asset-divider {
  width: 1rpx;
  background: var(--color-border);
  margin: 8rpx 0;
}

.benefit-card {
  margin: 0 24rpx 24rpx;
  padding: 28rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}
.benefit-hd {
  margin-bottom: 20rpx;
}
.benefit-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}
.benefit-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-muted);
}
.benefit-row {
  display: flex;
  gap: 12rpx;
}
.benefit-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 8rpx;
  background: #f7f8fc;
  border-radius: 12rpx;
}
.benefit-num {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-accent);
}
.benefit-label {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}
.grant-list {
  margin-top: 20rpx;
  border-top: 1rpx solid var(--color-border);
  padding-top: 12rpx;
}
.grant-item {
  padding: 12rpx 0;
}
.grant-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
}
.grant-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.menu-card {
  margin: 0 24rpx 24rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 28rpx;
  border-bottom: 1rpx solid var(--color-border);
}
.menu-item:last-child {
  border-bottom: none;
}
.menu-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  color: #fff;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.menu-icon.gold { background: linear-gradient(135deg, #c9a227, #e8c547); color: #1a1a2e; }
.menu-icon.blue { background: linear-gradient(135deg, #1a1a2e, #4a5568); color: #e8c547; }
.menu-icon.green { background: linear-gradient(135deg, #059669, #34d399); }
.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: var(--color-text);
}
.menu-badge {
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  padding: 0 10rpx;
  background: #ef4444;
  color: #fff;
  font-size: 22rpx;
  border-radius: 18rpx;
  text-align: center;
  margin-right: 8rpx;
}
.menu-arrow {
  font-size: 36rpx;
  color: var(--color-text-muted);
  font-weight: 300;
}

.records-card {
  margin: 0 24rpx 24rpx;
  padding: 28rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}
.records-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.record-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-border);
  font-size: 26rpx;
}
.record-row:last-child { border-bottom: none; }
.record-remark {
  flex: 1;
  color: var(--color-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}
.record-amount.plus { color: #059669; font-weight: 600; }
.record-amount.minus { color: #ef4444; font-weight: 600; }

.btn-logout {
  margin: 16rpx 24rpx 48rpx;
  background: transparent;
  color: var(--color-text-muted);
  font-size: 28rpx;
  border: none;
}
.btn-logout::after { border: none; }

.setup-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(15, 18, 32, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}
.setup-card {
  width: 100%;
  max-width: 620rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 48rpx 40rpx 36rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.setup-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text);
}
.setup-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--color-text-muted);
  text-align: center;
  line-height: 1.5;
}
.setup-avatar-btn {
  margin-top: 36rpx;
  padding: 0;
  background: transparent;
  border: none;
  line-height: normal;
}
.setup-avatar-btn::after { border: none; }
.setup-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: block;
  border: 4rpx solid rgba(201, 162, 39, 0.55);
}
.setup-avatar-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f3f4f8;
  color: var(--color-text-muted);
  font-size: 26rpx;
  font-weight: 600;
}
.setup-avatar-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--color-text-muted);
}
.setup-nickname {
  margin-top: 28rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  background: #f7f8fc;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: var(--color-text);
}
.setup-confirm {
  margin-top: 36rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
}
.setup-skip {
  margin-top: 8rpx;
  background: transparent;
  color: var(--color-text-muted);
  font-size: 26rpx;
  border: none;
}
.setup-skip::after { border: none; }

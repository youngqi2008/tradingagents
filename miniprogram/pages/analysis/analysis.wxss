.container { padding: 24rpx; }
.stock { font-size: 36rpx; font-weight: 600; margin-bottom: 16rpx; }
.price-info { color: #666; font-size: 26rpx; margin-bottom: 24rpx; }
.progress-box { margin: 24rpx 0; }
.status-msg { display: block; margin-top: 12rpx; color: #999; font-size: 24rpx; }
.status-error { color: #e74c3c; }
.elapsed {
  display: block;
  margin-top: 8rpx;
  color: #c9a227;
  font-size: 24rpx;
  font-weight: 600;
}
.wait-tip {
  margin: 8rpx 0 24rpx;
  padding: 20rpx 22rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, rgba(201, 162, 39, 0.12), rgba(232, 197, 71, 0.08));
  border: 1rpx solid rgba(201, 162, 39, 0.28);
}
.wait-tip.running {
  margin-top: 20rpx;
  margin-bottom: 0;
}
.wait-tip-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #8a6d1a;
  margin-bottom: 8rpx;
}
.wait-tip-desc {
  display: block;
  font-size: 24rpx;
  line-height: 1.55;
  color: #6b7280;
}
.link-back { display: block; margin-top: 24rpx; text-align: center; color: #666; font-size: 26rpx; }
.btn-retry { background: #e74c3c !important; }
.btn-later {
  margin-top: 20rpx;
  background: #fff !important;
  color: #1a1a2e !important;
  border: 1rpx solid #c9a227 !important;
  font-size: 28rpx;
  font-weight: 500;
}

<view class="page">
  <!-- 未登录 -->
  <view class="login-wrap" wx:if="{{!isLoggedIn}}">
    <view class="login-hero">
      <text class="login-logo">Ares</text>
      <text class="login-title">问股 · 研报</text>
      <text class="login-desc">智能问答与深度研报，一站完成</text>
    </view>
    <view class="login-features">
      <view class="feature-item">
        <text class="feature-dot">◆</text>
        <text>AI 智能问股，多策略分析</text>
      </view>
      <view class="feature-item">
        <text class="feature-dot">◆</text>
        <text>多智能体深度研报一键生成</text>
      </view>
      <view class="feature-item">
        <text class="feature-dot">◆</text>
        <text>多轮对话，研报列表可随时查看</text>
      </view>
    </view>
    <button class="btn-login" bindtap="onLoginTap">登录后使用</button>
  </view>

  <!-- 已登录主界面 -->
  <block wx:else>
    <view class="pane-bar">
      <view class="pane-item {{pane === 'chat' ? 'active' : ''}}" data-pane="chat" bindtap="switchPane">问股</view>
      <view class="pane-item {{pane === 'report' ? 'active' : ''}}" data-pane="report" bindtap="switchPane">研报</view>
    </view>

    <!-- 问股 -->
    <block wx:if="{{pane === 'chat'}}">
      <view class="top-bar">
        <view class="top-left" bindtap="toggleSessions">
          <view class="menu-icon"></view>
          <text class="session-title">{{currentSessionTitle}}</text>
        </view>
        <picker mode="selector" range="{{strategyNames}}" value="{{strategyIndex}}" bindchange="onStrategyChange">
          <view class="strategy-chip">
            <text class="chip-label">{{strategyNames[strategyIndex] || '策略'}}</text>
            <text class="chip-arrow">▾</text>
          </view>
        </picker>
        <view class="top-right" bindtap="onNewSession">
          <text class="new-icon">+</text>
        </view>
      </view>

      <view class="quota-bar" wx:if="{{userQuota}}">
        <text>问股免费 {{userQuota.ask_free_remaining}}/{{userQuota.ask_free_limit}}</text>
        <text class="quota-divider">|</text>
        <text>余额 ¥{{userQuota.balance}}</text>
      </view>

      <scroll-view
        class="message-area"
        scroll-y
        scroll-into-view="{{scrollIntoView}}"
        enhanced
        show-scrollbar="{{false}}"
      >
        <view wx:if="{{messages.length === 0 && !sending}}" class="welcome">
          <view class="welcome-icon">AI</view>
          <text class="welcome-title">有什么可以帮您？</text>
          <text class="welcome-sub">输入股票代码或问题，开始智能分析</text>
          <view class="quick-prompts">
            <view
              wx:for="{{quickPrompts}}"
              wx:key="*this"
              class="prompt-chip"
              data-text="{{item}}"
              bindtap="onQuickPrompt"
            >{{item}}</view>
          </view>
        </view>

        <view
          wx:for="{{messages}}"
          wx:key="id"
          id="msg-{{item.id}}"
          class="msg-row {{item.role}}"
        >
          <view class="avatar {{item.role}}">{{item.role === 'user' ? '我' : 'AI'}}</view>
          <view class="bubble-wrap">
            <view class="bubble" wx:if="{{item.role === 'user'}}">{{item.content}}</view>
            <view class="bubble md" wx:else>
              <rich-text nodes="{{item.contentHtml}}"></rich-text>
            </view>
          </view>
        </view>

        <view wx:if="{{sending}}" class="msg-row assistant">
          <view class="avatar assistant">AI</view>
          <view class="bubble-wrap">
            <view class="bubble typing">
              <text class="dot"></text><text class="dot"></text><text class="dot"></text>
              <text class="typing-hint">{{progressStatus || '分析中，请稍候…'}}</text>
            </view>
            <view class="ask-wait-tip">
              <text class="ask-wait-title">预计 1–5 分钟</text>
              <text class="ask-wait-desc">{{waitTip}}</text>
              <button class="ask-leave-btn" bindtap="goHomeWhileAsking">先回消息首页</button>
            </view>
          </view>
        </view>

        <view wx:if="{{followUpSuggestions.length && !sending}}" class="follow-up-block">
          <text class="follow-up-label">继续追问</text>
          <view class="follow-up-chips">
            <view
              wx:for="{{followUpSuggestions}}"
              wx:key="*this"
              class="follow-chip"
              data-text="{{item}}"
              bindtap="onFollowUpTap"
            >{{item}}</view>
          </view>
        </view>

        <view class="scroll-bottom" id="scroll-bottom"></view>
      </scroll-view>

      <view class="composer">
        <view class="composer-inner">
          <view class="input-with-clear composer-input-wrap">
            <input
              class="composer-input input-clearable"
              placeholder="问股票、看趋势、要策略…"
              value="{{inputText}}"
              bindinput="onInput"
              confirm-type="send"
              bindconfirm="onSend"
              disabled="{{sending}}"
              adjust-position="{{true}}"
            />
            <view class="input-clear" wx:if="{{inputText && !sending}}" catchtap="onClearInput">×</view>
          </view>
          <button
            class="send-btn {{inputText ? 'active' : ''}}"
            bindtap="onSend"
            loading="{{sending}}"
            disabled="{{sending || !inputText}}"
          >发送</button>
        </view>
      </view>
    </block>

    <!-- 研报 -->
    <scroll-view wx:elif="{{pane === 'report'}}" class="report-pane" scroll-y>
      <view class="create-card">
        <text class="create-title">AI 深度研报</text>
        <text class="create-desc">多智能体协作 · 一键生成专业分析</text>
        <view class="create-form">
          <view class="input-with-clear">
            <input
              class="code-input input-clearable"
              placeholder="输入股票代码，如 600519"
              value="{{reportStockCode}}"
              bindinput="onReportStockInput"
              confirm-type="search"
              bindconfirm="goAnalysis"
            />
            <view class="input-clear" wx:if="{{reportStockCode}}" catchtap="onClearReportStockCode">×</view>
          </view>
          <button class="btn-create" bindtap="goAnalysis">生成</button>
        </view>
        <text class="create-hint">深度研报约需 5–10 分钟，提交后可先离开，完成后在下方列表查看</text>
      </view>

      <view class="list-section">
        <view class="list-header">
          <text class="list-title">我的研报</text>
          <text class="list-count">{{reports.length}} 份</text>
        </view>
        <view class="running-hint" wx:if="{{hasRunning}}">有研报正在生成，列表将自动刷新进度</view>

        <view wx:if="{{reports.length === 0}}" class="empty-state">
          <view class="empty-icon">📊</view>
          <text class="empty-title">暂无研报</text>
          <text class="empty-desc">输入股票代码，立即生成 AI 分析报告</text>
        </view>

        <view
          wx:for="{{reports}}"
          wx:key="task_id"
          class="report-card"
          bindtap="openReport"
          data-id="{{item.task_id}}"
        >
          <view class="report-main">
            <text class="report-name">{{item.stock_name}}</text>
            <text class="report-code">{{item.stock_code}}</text>
          </view>
          <view class="report-footer">
            <text class="status-tag status-{{item.status}}">{{statusText[item.status] || item.status}}</text>
            <text class="report-time">{{item.created_at}}</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </block>

  <!-- 会话侧栏 -->
  <view class="drawer-mask {{showSessions ? 'show' : ''}}" bindtap="toggleSessions"></view>
  <view class="drawer {{showSessions ? 'show' : ''}}">
    <view class="drawer-header">
      <text class="drawer-title">历史会话</text>
      <text class="drawer-close" bindtap="toggleSessions">✕</text>
    </view>
    <scroll-view class="drawer-list" scroll-y>
      <view wx:if="{{sessions.length === 0}}" class="drawer-empty">暂无历史会话</view>
      <view
        wx:for="{{sessions}}"
        wx:key="session_id"
        class="session-item {{sessionId === item.session_id ? 'active' : ''}}"
        data-id="{{item.session_id}}"
        bindtap="onSelectSession"
      >
        <text class="session-name">{{item.title || item.stock_code || '问股会话'}}</text>
        <text class="session-meta">{{item.message_count}} 条消息</text>
      </view>
    </scroll-view>
    <button class="drawer-new btn-primary" bindtap="onNewSessionFromDrawer">新建会话</button>
  </view>
</view>

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--color-bg);
  box-sizing: border-box;
  padding-bottom: calc(110rpx + env(safe-area-inset-bottom));
}

/* 登录页 */
.login-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 40rpx 120rpx;
}
.login-hero {
  text-align: center;
  margin-bottom: 64rpx;
}
.login-logo {
  display: block;
  font-size: 72rpx;
  font-weight: 800;
  color: var(--color-accent);
  letter-spacing: 4rpx;
}
.login-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-primary);
  margin-top: 16rpx;
}
.login-desc {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-top: 16rpx;
}
.login-features {
  width: 100%;
  margin-bottom: 64rpx;
}
.feature-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: var(--color-text-secondary);
}
.feature-dot {
  color: var(--color-accent);
  font-size: 20rpx;
}
.btn-login {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #c9a227, #e8c547);
  color: #1a1a2e;
  font-weight: 600;
  font-size: 32rpx;
  border-radius: 48rpx;
  border: none;
}
.btn-login::after { border: none; }

/* 顶栏 */
.top-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: var(--color-surface);
  border-bottom: 1rpx solid var(--color-border);
  gap: 16rpx;
}
.top-left {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}
.menu-icon {
  width: 32rpx;
  height: 24rpx;
  position: relative;
  flex-shrink: 0;
}
.menu-icon::before,
.menu-icon::after,
.menu-icon {
  background: var(--color-primary);
}
.menu-icon::before,
.menu-icon::after {
  content: '';
  position: absolute;
  left: 0;
  width: 32rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--color-primary);
}
.menu-icon::before { top: 0; }
.menu-icon::after { bottom: 0; }
.menu-icon {
  height: 4rpx;
  margin-top: 10rpx;
  border-radius: 2rpx;
}
.session-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.strategy-chip {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 20rpx;
  background: #f3f5fa;
  border-radius: 32rpx;
  flex-shrink: 0;
}
.chip-label {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 500;
  max-width: 160rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.chip-arrow {
  font-size: 20rpx;
  color: var(--color-text-muted);
}
.top-right {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f3f5fa;
  border-radius: 50%;
  flex-shrink: 0;
}
.new-icon {
  font-size: 36rpx;
  color: var(--color-primary);
  font-weight: 300;
  line-height: 1;
}

.quota-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 12rpx 24rpx;
  font-size: 22rpx;
  color: var(--color-text-muted);
  background: rgba(201, 162, 39, 0.08);
}
.quota-divider { opacity: 0.4; }

/* 消息区 */
.message-area {
  flex: 1;
  min-height: 0;
  padding: 24rpx;
  box-sizing: border-box;
}

.welcome {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 32rpx 40rpx;
}
.welcome-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #1a1a2e, #2d3561);
  color: var(--color-accent);
  font-size: 40rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}
.welcome-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text);
}
.welcome-sub {
  font-size: 26rpx;
  color: var(--color-text-muted);
  margin-top: 12rpx;
}
.quick-prompts {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx;
  margin-top: 48rpx;
  width: 100%;
}
.prompt-chip {
  padding: 16rpx 28rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 32rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  box-shadow: var(--shadow-sm);
}

.follow-up-block {
  margin: 8rpx 0 24rpx 80rpx;
  padding-right: 24rpx;
}
.follow-up-label {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-muted);
  margin-bottom: 16rpx;
}
.follow-up-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.follow-chip {
  padding: 14rpx 24rpx;
  background: rgba(201, 162, 39, 0.1);
  border: 1rpx solid rgba(201, 162, 39, 0.35);
  border-radius: 32rpx;
  font-size: 24rpx;
  color: var(--color-primary);
  line-height: 1.4;
}

.msg-row {
  display: flex;
  margin-bottom: 28rpx;
  align-items: flex-start;
  gap: 16rpx;
}
.msg-row.user {
  flex-direction: row-reverse;
}
.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.avatar.user {
  background: linear-gradient(135deg, #c9a227, #e8c547);
  color: #1a1a2e;
}
.avatar.assistant {
  background: linear-gradient(135deg, #1a1a2e, #2d3561);
  color: var(--color-accent);
}
.bubble-wrap {
  max-width: 72%;
}
.bubble {
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 1.65;
  white-space: pre-wrap;
  word-break: break-word;
}
.msg-row.user .bubble {
  background: var(--color-user-bubble);
  border-bottom-right-radius: 6rpx;
}
.msg-row.assistant .bubble {
  background: var(--color-ai-bubble);
  border-bottom-left-radius: 6rpx;
}
.bubble.typing {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
  padding: 28rpx;
}
.typing-hint {
  width: 100%;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-muted);
}
.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-text-muted);
  animation: blink 1.2s infinite;
}
.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes blink {
  0%, 80%, 100% { opacity: 0.3; }
  40% { opacity: 1; }
}
.scroll-bottom { height: 20rpx; }

/* 输入区 */
.composer {
  background: var(--color-surface);
  border-top: 1rpx solid var(--color-border);
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}
.composer-inner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #f3f5fa;
  border-radius: 48rpx;
  padding: 8rpx 8rpx 8rpx 28rpx;
}
.composer-input {
  flex: 1;
  font-size: 28rpx;
  min-height: 72rpx;
}
.send-btn {
  flex-shrink: 0;
  width: 120rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0;
  margin: 0;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 36rpx;
  background: #d1d5db;
  color: #fff;
  border: none;
}
.send-btn::after { border: none; }
.send-btn.active {
  background: linear-gradient(135deg, #c9a227, #e8c547);
  color: #1a1a2e;
}

/* 侧栏 */
.drawer-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 1000;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s;
}
.drawer-mask.show {
  opacity: 1;
  pointer-events: auto;
}
.drawer {
  position: fixed;
  top: 0;
  left: 0;
  bottom: 0;
  width: 75%;
  max-width: 560rpx;
  background: var(--color-surface);
  z-index: 1001;
  transform: translateX(-100%);
  transition: transform 0.25s;
  display: flex;
  flex-direction: column;
  padding-bottom: calc(110rpx + env(safe-area-inset-bottom));
}
.drawer.show {
  transform: translateX(0);
}
.drawer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx 24rpx;
  border-bottom: 1rpx solid var(--color-border);
}
.drawer-title {
  font-size: 32rpx;
  font-weight: 700;
}
.drawer-close {
  font-size: 32rpx;
  color: var(--color-text-muted);
  padding: 8rpx;
}
.drawer-list {
  flex: 1;
  min-height: 0;
  padding: 16rpx;
}
.drawer-empty {
  text-align: center;
  color: var(--color-text-muted);
  padding: 48rpx;
  font-size: 26rpx;
}
.session-item {
  padding: 24rpx 20rpx;
  border-radius: var(--radius-md);
  margin-bottom: 8rpx;
}
.session-item.active {
  background: rgba(201, 162, 39, 0.12);
}
.session-name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text);
}
.session-meta {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-muted);
  margin-top: 6rpx;
}
.drawer-new {
  margin: 16rpx 24rpx 24rpx;
}

.page {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: calc(110rpx + env(safe-area-inset-bottom));
}

.create-card {
  margin: 24rpx;
  padding: 36rpx 32rpx;
  background: linear-gradient(135deg, #111111 0%, #1f1f1f 100%);
  border-radius: var(--radius-lg);
  box-shadow: 0 12rpx 40rpx rgba(26, 26, 46, 0.2);
}
.create-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}
.create-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
  margin-top: 8rpx;
  margin-bottom: 28rpx;
}
.create-form {
  display: flex;
  gap: 16rpx;
  align-items: center;
}
.create-hint {
  display: block;
  margin-top: 20rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: rgba(239, 68, 68, 0.92);
}
.code-input {
  flex: 1;
  height: 80rpx;
  background: rgba(255,255,255,0.95);
  border-radius: 40rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
}
.btn-create {
  flex-shrink: 0;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 40rpx;
  background: linear-gradient(135deg, #d4202a, #ef4444);
  color: #ffffff;
  font-weight: 600;
  font-size: 28rpx;
  border-radius: 40rpx;
  border: none;
}
.btn-create::after { border: none; }

.login-hint {
  margin: 48rpx 24rpx;
  text-align: center;
  color: var(--color-text-muted);
  font-size: 28rpx;
}
.btn-login-sm {
  margin-top: 24rpx;
  width: 320rpx;
  background: var(--color-surface);
  color: var(--color-primary);
  border: 2rpx solid var(--color-border);
  border-radius: 40rpx;
  font-size: 28rpx;
}
.btn-login-sm::after { border: none; }

.list-section {
  padding: 0 24rpx 24rpx;
}
.list-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}
.list-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text);
}
.list-count {
  font-size: 24rpx;
  color: var(--color-text-muted);
}
.running-hint {
  margin: -8rpx 8rpx 20rpx;
  font-size: 22rpx;
  color: #b45309;
  background: rgba(212, 32, 42, 0.12);
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
}

.empty-state {
  text-align: center;
  padding: 80rpx 32rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
}
.empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}
.empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}
.empty-desc {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-muted);
  margin-top: 12rpx;
}

.report-card {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-sm);
}
.report-main {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}
.report-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
}
.report-code {
  font-size: 24rpx;
  color: var(--color-text-muted);
}
.report-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}
.status-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
}
.status-completed {
  background: rgba(180, 83, 9, 0.12);
  color: #b45309;
}
.status-processing, .status-pending, .status-running {
  background: rgba(24, 144, 255, 0.12);
  color: #096dd9;
}
.status-failed {
  background: rgba(255, 77, 79, 0.12);
  color: #cf1322;
}
.report-time {
  font-size: 22rpx;
  color: var(--color-text-muted);
}

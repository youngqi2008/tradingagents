.page {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: calc(110rpx + env(safe-area-inset-bottom));
}

.hero {
  margin: 24rpx;
  padding: 48rpx 36rpx 40rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #111111 0%, #1f1f1f 62%, #7f1d1d 160%);
  color: #fff;
  box-shadow: 0 12rpx 36rpx rgba(17, 17, 17, 0.22);
}

.hero-kicker {
  display: inline-block;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: rgba(239, 68, 68, 0.22);
  color: #fda4af;
}

.hero-title {
  display: block;
  margin-top: 20rpx;
  font-size: 56rpx;
  font-weight: 800;
  line-height: 1.2;
}

.hero-desc {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.74);
}

.section-hd {
  margin: 8rpx 32rpx 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
}

.feature-card {
  display: flex;
  align-items: center;
  margin: 0 24rpx 16rpx;
  padding: 28rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.feature-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #b91c1c, #ef4444);
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.feature-icon.dark {
  background: linear-gradient(135deg, #111111, #3f3f46);
}

.feature-icon.gray {
  background: #e4e4e7;
  color: #3f3f46;
}

.feature-body {
  flex: 1;
  min-width: 0;
  margin: 0 20rpx;
}

.feature-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.feature-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--color-text-muted);
}

.feature-arrow {
  font-size: 36rpx;
  color: var(--color-text-muted);
  font-weight: 300;
}

.guide-card {
  margin: 0 24rpx 24rpx;
  padding: 8rpx 28rpx 12rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.guide-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.guide-item:last-child {
  border-bottom: none;
}

.guide-num {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: #fff1f2;
  color: #d4202a;
  font-size: 26rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.guide-body {
  flex: 1;
  margin-left: 20rpx;
}

.guide-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
}

.guide-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--color-text-muted);
  line-height: 1.5;
}

.faq-card {
  margin: 0 24rpx 24rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.faq-item {
  padding: 28rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.faq-item:last-child {
  border-bottom: none;
}

.faq-q {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}

.faq-toggle {
  color: var(--color-text-muted);
  font-size: 32rpx;
  font-weight: 400;
}

.faq-a {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.notice-card {
  margin: 0 24rpx 48rpx;
  padding: 28rpx;
  background: #fafafa;
  border-radius: var(--radius-lg);
  border: 1rpx solid var(--color-border);
}

.notice-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
}

.notice-text {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: var(--color-text-muted);
}

.member-entry {
  display: flex;
  align-items: center;
}
.member-entry-body {
  flex: 1;
  min-width: 0;
}
.member-entry-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
}
.member-entry-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8b8b93;
}
.member-entry-arrow {
  font-size: 36rpx;
  color: #8b8b93;
  font-weight: 300;
}
.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 8rpx 24rpx 0;
  font-size: 26rpx;
}
.toolbar-actions {
  display: flex;
  gap: 24rpx;
}
.unread-tip {
  color: #d4202a;
  font-weight: 600;
}
.unread-tip.muted {
  color: #9ca3af;
  font-weight: 400;
}
.mark-all {
  color: #666;
}
.empty {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
}
.guest-panel {
  padding-bottom: 8rpx;
}
.guest-card {
  margin-top: 8rpx;
}
.guest-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}
.guest-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}
.guest-login {
  margin: 24rpx 48rpx 8rpx;
}
.login-hint {
  display: block;
  font-size: 24rpx;
  color: #9ca3af;
  padding: 0 48rpx 16rpx;
  line-height: 1.5;
  text-align: center;
}
.item {
  margin-top: 8rpx;
}
.item.unread {
  border-left: 6rpx solid #d4202a;
}
.item-title {
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}
.signal-tag {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  line-height: 1.4;
}
.signal-tag.buy {
  background: rgba(225, 29, 46, 0.12);
  color: #e11d2e;
}
.signal-tag.sell {
  background: rgba(107, 114, 128, 0.15);
  color: #52525b;
}
.dot {
  color: #d4202a;
  margin-right: 8rpx;
}
.item-preview {
  color: #666;
  font-size: 26rpx;
  margin-top: 12rpx;
  line-height: 1.5;
}
.item-time {
  color: #999;
  font-size: 22rpx;
  margin-top: 12rpx;
}
.detail-card {
  margin-top: 8rpx;
}
.detail-title {
  font-size: 36rpx;
  font-weight: 700;
}
.detail-time {
  color: #999;
  font-size: 24rpx;
  margin: 16rpx 0 24rpx;
}
.detail-content {
  white-space: pre-wrap;
  line-height: 1.7;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 32rpx;
}
.detail-push {
  margin-bottom: 16rpx;
}
.detail-push-hint {
  display: block;
  text-align: center;
  color: #9ca3af;
  font-size: 22rpx;
  line-height: 1.5;
  margin-bottom: 24rpx;
  padding: 0 12rpx;
}

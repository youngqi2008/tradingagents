<view class="page container">
  <view class="hero">
    <text class="hero-kicker">服务动态</text>
    <text class="hero-title">Ares</text>
    <text class="hero-desc">打开即可浏览服务动态说明。登录后可查看个人动态并自行开启微信提醒。</text>
  </view>

  <view class="card member-entry" bindtap="goMembership">
    <view class="member-entry-body">
      <text class="member-entry-title">会员</text>
      <text class="member-entry-desc">查看等级权益，登录后可申请开通</text>
    </view>
    <text class="member-entry-arrow">›</text>
  </view>

  <view wx:if="{{needLogin && !detail}}" class="guest-panel">
    <view class="card guest-card">
      <view class="guest-title">服务动态说明</view>
      <text class="guest-desc">这里展示已订阅的服务更新。可先浏览下方示例与帮助，需要个人动态时再到「我的」自行登录。</text>
    </view>
    <view
      wx:for="{{samples}}"
      wx:key="id"
      class="card item"
      data-id="{{item.id}}"
      bindtap="onTapSample"
    >
      <view class="item-title">
        <text class="signal-tag {{item.typeClass}}">{{item.typeLabel}}</text>
        {{item.title}}
      </view>
      <view class="item-preview">{{item.preview}}</view>
      <view class="item-time">{{item.timeText}}</view>
    </view>
    <button class="btn-outline guest-login" bindtap="onLoginTap">登录后查看我的动态</button>
    <text class="login-hint">登录为可选项，浏览本页无需授权手机号、头像或昵称</text>
  </view>

  <block wx:elif="{{!needLogin}}">
    <view wx:if="{{!detail}}">
      <view class="toolbar">
        <text class="unread-tip" wx:if="{{unreadCount > 0}}">未读 {{unreadCount}}</text>
        <text class="unread-tip muted" wx:else>暂无未读</text>
        <view class="toolbar-actions">
          <text class="mark-all" bindtap="onEnablePush">{{pushAlways ? '已记住提醒' : (pushRejected ? '重新开启提醒' : (pushStatusText === '已开启' ? '已开启提醒' : '开启微信提醒'))}}</text>
          <text class="mark-all" bindtap="onMarkAllRead">全部已读</text>
        </view>
      </view>
      <view wx:if="{{loading}}" class="empty">加载中...</view>
      <view wx:elif="{{notifications.length === 0}}" class="empty">暂无服务动态</view>
      <view
        wx:for="{{notifications}}"
        wx:key="id"
        class="card item {{item.is_read ? '' : 'unread'}}"
        data-id="{{item.id}}"
        bindtap="onTapItem"
      >
        <view class="item-title">
          <text wx:if="{{item.typeLabel}}" class="signal-tag {{item.typeClass}}">{{item.typeLabel}}</text>
          <text wx:if="{{!item.is_read}}" class="dot">●</text>
          {{item.title}}
        </view>
        <view class="item-preview">{{item.preview}}</view>
        <view class="item-time">{{item.timeText}}</view>
      </view>
    </view>
  </block>

  <view wx:if="{{detail}}" class="card detail-card">
    <view class="detail-title">
      <text wx:if="{{detail.typeLabel}}" class="signal-tag {{detail.typeClass}}">{{detail.typeLabel}}</text>
      {{detail.title}}
    </view>
    <view class="detail-time">{{detail.timeText}}</view>
    <view class="detail-content">{{detail.content}}</view>
    <button wx:if="{{!needLogin && !pushAlways}}" class="btn-primary detail-push" bindtap="onEnablePush">继续接收下一条微信提醒</button>
    <text wx:if="{{!needLogin && !pushAlways}}" class="detail-push-hint">勾选「总是保持以上选择」后，点开动态就会自动续，不必每次点这里</text>
    <button class="btn-outline" bindtap="onCloseDetail">返回列表</button>
  </view>

  <block wx:if="{{!detail}}">
    <view class="section-hd">使用帮助</view>
    <view class="faq-card">
      <view
        wx:for="{{faqs}}"
        wx:key="id"
        class="faq-item"
        data-id="{{item.id}}"
        bindtap="toggleFaq"
      >
        <view class="faq-q">
          <text>{{item.q}}</text>
          <text class="faq-toggle">{{item.open ? '−' : '+'}}</text>
        </view>
        <text class="faq-a" wx:if="{{item.open}}">{{item.a}}</text>
      </view>
    </view>
  </block>
</view>

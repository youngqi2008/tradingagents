<view class="container">
  <view wx:if="{{needLogin}}" class="empty login-empty">
    <text class="login-tip">消息为个人服务，登录后可查看关注信号与推送</text>
    <button class="btn-primary" bindtap="onLoginTap">登录</button>
    <text class="login-hint">可先浏览「行情」与「新闻」，无需登录</text>
  </view>

  <block wx:else>
    <view wx:if="{{!detail}}">
      <view class="signal-hero" wx:if="{{activeCategory === 'signal'}}">
        <view class="signal-hero-kicker">首页 · 优先查看</view>
        <view class="signal-hero-title">关注信号</view>
        <view class="signal-hero-sub">自选股关注 / 取消关注推送，未读优先处理</view>
      </view>

      <view class="category-bar">
        <view
          wx:for="{{categories}}"
          wx:key="key"
          class="category-item {{item.featured ? 'featured' : ''}} {{activeCategory === item.key ? 'active' : ''}}"
          data-key="{{item.key}}"
          bindtap="onCategoryTap"
        >{{item.label}}</view>
      </view>

      <view class="toolbar">
        <text class="unread-tip" wx:if="{{unreadCount > 0}}">全部未读 {{unreadCount}}</text>
        <text class="unread-tip muted" wx:elif="{{categoryUnread > 0}}">本类未读 {{categoryUnread}}</text>
        <text class="unread-tip muted" wx:else>暂无未读</text>
        <text class="mark-all" bindtap="onMarkAllRead">全部已读</text>
      </view>

      <view wx:if="{{loading}}" class="empty">加载中...</view>
      <view wx:elif="{{notifications.length === 0}}" class="empty">
        {{activeCategory === 'digest' ? '暂无自选股日报，工作日将按自选股推送到这里' : '暂无此类消息'}}
      </view>

      <view
        wx:for="{{notifications}}"
        wx:key="id"
        class="card item {{item.is_read ? '' : 'unread'}}"
        data-id="{{item.id}}"
        bindtap="onTapItem"
      >
        <view class="item-title">
          <text wx:if="{{item.typeLabel}}" class="signal-tag {{item.typeClass}}">{{item.typeLabel}}</text>
          <text wx:if="{{!item.is_read}}" class="dot">●</text>
          {{item.title}}
        </view>
        <view class="item-preview">{{item.preview}}</view>
        <view class="item-time">{{item.timeText}}</view>
        <view class="item-actions" wx:if="{{item.canAct}}" catchtap="noop">
          <view
            class="action-chip"
            catchtap="goAskStock"
            data-code="{{item.stockCode}}"
            data-type="{{item.notice_type}}"
          >问股</view>
          <view
            class="action-chip primary"
            catchtap="goGenerateReport"
            data-code="{{item.stockCode}}"
            data-type="{{item.notice_type}}"
          >生成研报</view>
        </view>
      </view>
    </view>

    <view wx:else class="card detail-card">
      <view class="detail-title">
        <text wx:if="{{detail.typeLabel}}" class="signal-tag {{detail.typeClass}}">{{detail.typeLabel}}</text>
        {{detail.title}}
      </view>
      <view class="detail-time">{{detail.timeText}}</view>
      <view class="detail-content">{{detail.content}}</view>

      <view class="detail-actions" wx:if="{{detail.canAct}}">
        <button
          class="btn-action"
          bindtap="goAskStock"
          data-code="{{detail.stockCode}}"
          data-type="{{detail.notice_type}}"
        >问股分析 {{detail.stockCode}}</button>
        <button
          class="btn-action primary"
          bindtap="goGenerateReport"
          data-code="{{detail.stockCode}}"
          data-type="{{detail.notice_type}}"
        >生成研报 {{detail.stockCode}}</button>
      </view>

      <button class="btn-outline" bindtap="onCloseDetail">返回列表</button>
    </view>
  </block>
</view>

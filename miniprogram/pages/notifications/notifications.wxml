<view class="container">
  <view wx:if="{{needLogin}}" class="guest-panel">
    <view class="card guest-card">
      <view class="guest-title">消息说明</view>
      <text class="guest-desc">消息中心用于查看公告、风控与个人通知。打开即可了解分类，登录后可查看属于自己的通知。</text>
    </view>
    <view class="card guest-card">
      <view class="guest-title">消息类型</view>
      <text class="guest-line">· 服务动态：已订阅的服务更新</text>
      <text class="guest-line">· 广播消息：平台公告</text>
      <text class="guest-line">· 风控消息：风控相关通知</text>
    </view>
    <button class="btn-outline guest-login" bindtap="onLoginTap">登录后查看我的消息</button>
    <text class="login-hint">登录为可选项，浏览说明无需授权手机号、头像或昵称</text>
  </view>

  <block wx:else>
    <view wx:if="{{!detail}}">
      <view class="category-bar">
        <view
          wx:for="{{categories}}"
          wx:key="key"
          class="category-item {{activeCategory === item.key ? 'active' : ''}}"
          data-key="{{item.key}}"
          bindtap="onCategoryTap"
        >{{item.label}}</view>
      </view>

      <view class="toolbar">
        <text class="unread-tip" wx:if="{{unreadCount > 0}}">全部未读 {{unreadCount}}</text>
        <text class="unread-tip muted" wx:elif="{{categoryUnread > 0}}">本类未读 {{categoryUnread}}</text>
        <text class="unread-tip muted" wx:else>暂无未读</text>
        <text class="mark-all" bindtap="onMarkAllRead">全部已读</text>
      </view>

      <view wx:if="{{loading}}" class="empty">加载中...</view>
      <view wx:elif="{{notifications.length === 0}}" class="empty">{{emptyHint}}</view>

      <view
        wx:for="{{notifications}}"
        wx:key="id"
        class="card item {{item.is_read ? '' : 'unread'}}"
        data-id="{{item.id}}"
        bindtap="onTapItem"
      >
        <view class="item-title">
          <text wx:if="{{item.typeLabel}}" class="signal-tag {{item.typeClass}}">{{item.typeLabel}}</text>
          <text wx:if="{{!item.is_read}}" class="dot">●</text>
          {{item.title}}
        </view>
        <view class="item-preview">{{item.preview}}</view>
        <view class="item-time">{{item.timeText}}</view>
      </view>
    </view>

    <view wx:else class="card detail-card">
      <view class="detail-title">
        <text wx:if="{{detail.typeLabel}}" class="signal-tag {{detail.typeClass}}">{{detail.typeLabel}}</text>
        {{detail.title}}
      </view>
      <view class="detail-time">{{detail.timeText}}</view>
      <view class="detail-content">{{detail.content}}</view>
      <button class="btn-outline" bindtap="onCloseDetail">返回列表</button>
    </view>
  </block>
</view>

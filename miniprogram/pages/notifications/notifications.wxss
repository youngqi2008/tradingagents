.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 16rpx 24rpx 0;
  font-size: 26rpx;
}
.signal-hero {
  margin: 20rpx 24rpx 8rpx;
  padding: 32rpx 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #111111 0%, #1f1f1f 58%, #d4202a 160%);
  color: #fff;
  box-shadow: 0 12rpx 36rpx rgba(26, 26, 46, 0.22);
}
.signal-hero-kicker {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(239, 68, 68, 0.22);
  color: #ef4444;
}
.signal-hero-title {
  margin-top: 16rpx;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.2;
}
.signal-hero-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
  line-height: 1.5;
}
.category-bar {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  padding: 16rpx 16rpx 0;
  box-sizing: border-box;
}
.category-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  padding: 12rpx 22rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #6b7280;
  background: #eef1f7;
}
.category-item.featured {
  padding: 14rpx 32rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #9f1239;
  background: #ffe4e6;
  border: 2rpx solid rgba(212, 32, 42, 0.55);
}
.category-item.active {
  color: #111111;
  background: linear-gradient(135deg, #ef4444, #d4202a);
  font-weight: 600;
  border-color: transparent;
}
.category-item.featured.active {
  font-weight: 800;
  box-shadow: 0 8rpx 20rpx rgba(212, 32, 42, 0.35);
}
.unread-tip {
  color: #d4202a;
  font-weight: 600;
}
.unread-tip.muted {
  color: #9ca3af;
  font-weight: 400;
}
.mark-all {
  color: #666;
}
.empty {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
}
.guest-panel {
  padding: 8rpx 0 24rpx;
}
.guest-card {
  margin-top: 8rpx;
}
.guest-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}
.guest-desc,
.guest-line {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}
.guest-line {
  margin-top: 8rpx;
}
.guest-login {
  margin: 24rpx 48rpx 8rpx;
}
.login-hint {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #9ca3af;
  padding: 0 48rpx;
  line-height: 1.5;
}
.item {
  margin-top: 16rpx;
}
.item.unread {
  border-left: 6rpx solid #d4202a;
}
.item-title {
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}
.signal-tag {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  line-height: 1.4;
}
.signal-tag.buy {
  background: rgba(225, 29, 46, 0.12);
  color: #e11d2e;
}
.signal-tag.sell {
  background: rgba(107, 114, 128, 0.15);
  color: #52525b;
}
.signal-tag.risk {
  background: rgba(212, 32, 42, 0.12);
  color: #d4202a;
}
.signal-tag.broadcast {
  background: rgba(59, 130, 246, 0.12);
  color: #2563eb;
}
.signal-tag.review {
  background: rgba(139, 92, 246, 0.12);
  color: #7c3aed;
}
.signal-tag.custom {
  background: rgba(14, 165, 233, 0.12);
  color: #0284c7;
}
.dot {
  color: #d4202a;
  margin-right: 8rpx;
}
.item-preview {
  color: #666;
  font-size: 26rpx;
  margin-top: 12rpx;
  line-height: 1.5;
}
.item-time {
  color: #999;
  font-size: 22rpx;
  margin-top: 12rpx;
}
.item-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}
.action-chip {
  padding: 8rpx 22rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #111111;
  background: #eef1f7;
  border: 1rpx solid #d8dee9;
}
.action-chip.primary {
  color: #9f1239;
  background: rgba(212, 32, 42, 0.16);
  border-color: rgba(212, 32, 42, 0.4);
}
.detail-card {
  margin-top: 16rpx;
}
.detail-title {
  font-size: 36rpx;
  font-weight: 700;
}
.detail-time {
  color: #999;
  font-size: 24rpx;
  margin: 16rpx 0 24rpx;
}
.detail-content {
  white-space: pre-wrap;
  line-height: 1.7;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 32rpx;
}
.detail-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.btn-action {
  margin: 0;
  background: #fff;
  color: #111111;
  border: 1px solid #d4202a;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.btn-action::after { border: none; }
.btn-action.primary {
  background: linear-gradient(135deg, #ef4444, #d4202a);
  border-color: transparent;
  color: #111111;
}
.btn-outline {
  background: #fff;
  color: #111111;
  border: 1px solid #d4202a;
  border-radius: 12rpx;
}

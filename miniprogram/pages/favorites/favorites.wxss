.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 48rpx;
  background: #f0f2f8;
  box-sizing: border-box;
}
.login-tip {
  margin-top: 120rpx;
  text-align: center;
  color: #666;
}
.login-tip .btn {
  margin-top: 32rpx;
  background: #111111;
  color: #d4202a;
}
.add-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.input {
  flex: 1;
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
}
.btn-add {
  background: #111111 !important;
  color: #d4202a !important;
  margin: 0;
}
.suggest {
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}
.suggest-item {
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.suggest-item .code {
  width: 140rpx;
  font-weight: 600;
  color: #111111;
}
.suggest-item .name {
  flex: 1;
  color: #555;
}
.suggest-item .plus {
  color: #d4202a;
  font-size: 24rpx;
}
.section-title {
  font-size: 28rpx;
  color: #333;
  margin: 8rpx 0 16rpx;
  font-weight: 600;
}
.empty {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
  background: #fff;
  border-radius: 12rpx;
}
.list {
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}
.row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f3f4f6;
}
.row-main {
  flex: 1;
}
.row-top .code {
  font-weight: 700;
  margin-right: 12rpx;
  color: #111;
}
.row-top .name {
  color: #666;
  font-size: 26rpx;
}
.row-bot {
  margin-top: 8rpx;
  display: flex;
  gap: 20rpx;
  font-size: 26rpx;
}
.pct.up { color: var(--color-up); }
.pct.down { color: var(--color-down); }
.remove {
  color: #999;
  font-size: 24rpx;
  padding: 12rpx 8rpx;
}
.hint {
  margin-top: 28rpx;
  font-size: 22rpx;
  color: #9ca3af;
  line-height: 1.5;
  text-align: center;
}

<view class="page">
  <view class="toolbar" wx:if="{{!detail}}">
    <view class="chip {{onlyFav ? 'on' : ''}}" bindtap="toggleOnlyFav">只看自选</view>
    <view class="chip" bindtap="onRefresh">刷新</view>
  </view>

  <view class="login-tip" wx:if="{{!isLoggedIn}}">
    <text>登录后可查看财经新闻并标记自选相关</text>
    <button class="btn" bindtap="goLogin">去登录</button>
  </view>

  <block wx:elif="{{detail}}">
    <view class="detail-card">
      <view class="detail-hd">
        <view class="badges">
          <text class="tag fav-tag" wx:if="{{detail.highlight}}">自选</text>
          <text class="tag code" wx:if="{{detail.symbol}}">{{detail.symbol}}</text>
          <text class="tag name" wx:if="{{detail.stock_name}}">{{detail.stock_name}}</text>
        </view>
        <text class="time">{{detail.timeText}}</text>
      </view>
      <view class="detail-title">{{detail.title}}</view>
      <view class="detail-meta">
        <text>{{detail.source || '财经资讯'}}</text>
        <text wx:if="{{detail.favorite_symbolsText}}">关联 {{detail.favorite_symbolsText}}</text>
      </view>
      <view class="detail-content">{{detail.content || detail.summary || '暂无正文'}}</view>

      <view class="detail-actions">
        <button class="btn-action" wx:if="{{detail.url}}" bindtap="onOpenLink">打开原文</button>
        <button class="btn-action" wx:if="{{detail.url}}" bindtap="onCopyLink">复制链接</button>
        <button class="btn-action primary" wx:if="{{detail.symbol}}" bindtap="onGoKline">查看行情 {{detail.symbol}}</button>
      </view>
      <button class="btn-back" bindtap="onCloseDetail">返回列表</button>
    </view>
  </block>

  <block wx:else>
    <view class="empty" wx:if="{{isLoggedIn && !loading && !displayList.length}}">
      暂无最近财经新闻，请稍后刷新
    </view>

    <view class="list" wx:if="{{displayList.length}}">
      <view
        class="card {{item.highlight ? 'fav' : ''}}"
        wx:for="{{displayList}}"
        wx:key="id"
        bindtap="onOpen"
        data-id="{{item.id}}"
      >
        <view class="card-hd">
          <view class="badges">
            <text class="tag fav-tag" wx:if="{{item.highlight}}">自选</text>
            <text class="tag code" wx:if="{{item.symbol}}">{{item.symbol}}</text>
            <text class="tag name" wx:if="{{item.stock_name}}">{{item.stock_name}}</text>
          </view>
          <text class="time">{{item.timeText}}</text>
        </view>
        <text class="title">{{item.title}}</text>
        <text class="summary" wx:if="{{item.summary}}">{{item.summary}}</text>
        <view class="card-ft">
          <text class="source">{{item.source || '财经资讯'}}</text>
          <text class="expand-hint">{{item.hasMore || item.content ? '点击查看全文 ›' : '点击查看 ›'}}</text>
        </view>
      </view>
    </view>

    <view class="loading" wx:if="{{loading}}">加载中...</view>
  </block>
</view>

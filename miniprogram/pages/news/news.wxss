.page {
  min-height: 100vh;
  padding: 20rpx 24rpx calc(140rpx + env(safe-area-inset-bottom));
  background: #f0f2f8;
  box-sizing: border-box;
}
.toolbar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.chip {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #6b7280;
  font-size: 24rpx;
  border: 1rpx solid #e5e7eb;
}
.chip.on {
  background: #1a1a2e;
  color: #c9a227;
  border-color: #1a1a2e;
}
.login-tip {
  margin-top: 80rpx;
  text-align: center;
  color: #666;
}
.login-tip .btn {
  margin-top: 28rpx;
  background: #1a1a2e;
  color: #c9a227;
}
.empty,
.loading {
  text-align: center;
  color: #9ca3af;
  padding: 80rpx 0;
  font-size: 26rpx;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid transparent;
  box-shadow: 0 4rpx 16rpx rgba(26, 26, 46, 0.04);
}
.card.fav {
  background: linear-gradient(180deg, #fff9e8 0%, #ffffff 48%);
  border-color: #e8c547;
  box-shadow: 0 6rpx 20rpx rgba(201, 162, 39, 0.18);
}
.card-hd {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.badges {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  flex: 1;
}
.tag {
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  background: #f3f4f6;
  color: #6b7280;
}
.fav-tag {
  background: #c9a227;
  color: #1a1a2e;
  font-weight: 700;
}
.code {
  background: #eef2ff;
  color: #4338ca;
}
.time {
  font-size: 22rpx;
  color: #9ca3af;
  white-space: nowrap;
}
.title {
  display: block;
  font-size: 30rpx;
  font-weight: 650;
  color: #111827;
  line-height: 1.45;
}
.card.fav .title {
  color: #1a1a2e;
  font-weight: 750;
}
.summary {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.5;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.card-ft {
  margin-top: 14rpx;
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  font-size: 22rpx;
  color: #9ca3af;
}
.more {
  color: #c9a227;
}

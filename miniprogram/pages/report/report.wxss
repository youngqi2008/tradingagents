.title { font-size: 34rpx; font-weight: 600; }
.summary { margin-top: 20rpx; line-height: 1.6; color: #444; }
.rec, .risk { margin-top: 16rpx; color: #666; }
.actions button { margin-bottom: 16rpx; }
.wait-card {
  text-align: center;
  padding-top: 40rpx;
  padding-bottom: 40rpx;
}
.wait-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 16rpx;
}
.wait-desc {
  display: block;
  font-size: 26rpx;
  line-height: 1.6;
  color: #6b7280;
  padding: 0 12rpx;
}
.wait-meta {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #c9a227;
  font-weight: 600;
}
.btn-outline {
  margin-top: 32rpx;
  background: #fff;
  color: #1a1a2e;
  border: 1px solid #c9a227;
  border-radius: 12rpx;
  font-size: 28rpx;
}

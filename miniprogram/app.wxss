/* Ares 设计系统 · 红黑金融风 */
page {
  /* 基色：黑 / 红 / 灰白 */
  --color-bg: #f2f2f3;
  --color-surface: #ffffff;
  --color-primary: #111111;
  --color-accent: #d4202a;
  --color-accent-light: #ef4444;
  --color-accent-soft: #fff1f2;
  --color-text: #111111;
  --color-text-secondary: #52525b;
  --color-text-muted: #8b8b93;
  --color-border: #e4e4e7;
  /* 涨跌：红涨 · 灰跌（少绿） */
  --color-up: #e11d2e;
  --color-down: #6b7280;
  /* 状态：完成用琥珀金，失败用红，进行中用深灰 */
  --color-ok: #b45309;
  --color-danger: #d4202a;
  --color-info: #3f3f46;
  --color-user-bubble: #ffe4e6;
  --color-ai-bubble: #f4f4f5;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --shadow-sm: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  --tab-height: 110rpx;
  background: var(--color-bg);
  color: var(--color-text);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

.container {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(var(--tab-height) + env(safe-area-inset-bottom));
}

.container--no-tab {
  padding-bottom: env(safe-area-inset-bottom);
}

.card {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  margin: 24rpx;
  box-shadow: var(--shadow-sm);
}

.btn-primary {
  background: linear-gradient(135deg, #b91c1c 0%, #ef4444 100%);
  color: #ffffff;
  border: none;
  border-radius: var(--radius-md);
  font-weight: 600;
  font-size: 28rpx;
}

.btn-primary::after {
  border: none;
}

.btn-outline {
  background: var(--color-surface);
  color: var(--color-primary);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  font-size: 28rpx;
}

.btn-outline::after {
  border: none;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 20rpx;
}

.text-muted {
  color: var(--color-text-muted);
  font-size: 24rpx;
}

.text-up {
  color: var(--color-up);
}
.text-down {
  color: var(--color-down);
}

/* 输入框一键清空 */
.input-with-clear {
  position: relative;
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
}
.input-with-clear .input-clearable {
  width: 100%;
  box-sizing: border-box;
  padding-right: 64rpx !important;
}
.input-clear {
  position: absolute;
  right: 12rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 2;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(17, 17, 17, 0.28);
  color: #fff;
  font-size: 28rpx;
  line-height: 44rpx;
  text-align: center;
  font-weight: 600;
}
.input-clear:active {
  opacity: 0.75;
}

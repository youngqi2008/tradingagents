# 47.95.5.18 生产环境 .env 片段（合并进服务器 .env）
# Mongo：compose 全新容器 | Redis：Dify 共用 | MySQL：宿主机 13306

# ---------- MongoDB（由 docker-compose.hub.nginx.47.yml 启动，backend 用服务名 mongodb）----------
# 国内拉取失败时可设: MONGO_IMAGE=docker.m.daocloud.io/library/mongo:4.4
# MONGO_IMAGE=mongo:4.4
MONGODB_ENABLED=true
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_USERNAME=admin
MONGODB_PASSWORD=tradingagents123
MONGODB_DATABASE=tradingagents
MONGODB_AUTH_SOURCE=admin
MONGODB_CONNECTION_STRING=mongodb://admin:tradingagents123@mongodb:27017/tradingagents?authSource=admin

# ---------- Redis（宿主机 Dify，勿用 db 0）----------
REDIS_ENABLED=true
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=difyai123456
REDIS_DB=1

# 若 Ares 已加入 Dify docker 网络（推荐，见 dify-redis overlay）:
DIFY_DOCKER_NETWORK=docker_default
REDIS_HOST=redis

# 仅当 Dify 已将 Redis 映射到宿主机 6379 时再用:
# REDIS_HOST=host.docker.internal

# ---------- MySQL（与现网相同）----------
MYSQL_HOST=host.docker.internal
MYSQL_PORT=13306
MYSQL_USER=root
MYSQL_PASSWORD=Zhys#2025
MYSQL_DATABASE=ares_ops

# 容器内若 host.docker.internal 不通，可改为:
# MYSQL_HOST=47.95.5.18

# ---------- Nginx 端口（80/8080/8888 常被占用，默认 18888）----------

# 生产部署配置（复制为 deploy.config 后修改）
# cp scripts/deploy/deploy.config.example scripts/deploy/deploy.config

# 目标服务器
DEPLOY_HOST=47.95.5.18
DEPLOY_USER=root
DEPLOY_PORT=22
# 服务器上项目目录（需已存在或可创建）
DEPLOY_PATH=/opt/tradingagents

# SSH 私钥（Windows 示例；Linux 可留空使用默认 ~/.ssh/id_rsa）
# SSH_KEY=C:\Users\you\.ssh\id_rsa

# docker compose 文件（相对项目根目录）
# 47.95.5.18：全新 Mongo + 外部 Redis(Dify) + 外部 MySQL(13306)
COMPOSE_FILE=docker-compose.hub.nginx.47.yml
COMPOSE_OVERRIDE=docker-compose.hub.nginx.47.dify-redis.yml

# 公网访问地址（健康检查、小程序 BASE_URL 提示）
PUBLIC_URL=http://47.95.5.18:18888
